<?xml version="1.0" encoding="utf-8"?>
<!--
  Section C + Section 0 (API-23 branching) + Section E permissions.

  The runtime-permission matrix is enforced in code (PermissionsManager) by
  branching on Build.VERSION.SDK_INT; this manifest declares the *union* of
  what every supported API level may need, with maxSdkVersion attributes so a
  modern device never prompts for a legacy permission it doesn't use.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sockets for the transfer protocol and the Web Connect server. LAN-only
         by design; there is no cloud relay, but Android still requires INTERNET
         to open a socket at all. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- mDNS discovery needs multicast; without the lock Android drops the
         multicast packets the moment the screen powers the radio down. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Nearby-device discovery on API 33+. neverForLocation: we derive no
         physical location from this. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- Pre-33, mDNS peer discovery is gated behind location. Capped at 32 so
         modern devices never see it. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Storage: pre-33 broad read, pre-30 write; 33+ granular media reads. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- QR scanning (Section 3 fallback / Section 8 room join). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Transfer + chat notifications, API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground services for transfer liveness and background audio. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Files/History "Install" action for received APKs (API 26+ concept). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Privacy-respecting app enumeration (Section E.2). We only need to list
      launchable apps so they can be sent as APKs; <queries> grants exactly that
      visibility without QUERY_ALL_PACKAGES, which Play policy disfavors.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
    </queries>

    <application
        android:label="Morse Code"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps discovery + an active transfer alive when backgrounded. -->
        <service
            android:name=".MorseForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Dedicated background-audio service (Section F.3). -->
        <service
            android:name="net.morsecode.player.AudioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Receives the "install received APK" action. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
